---
/*
 * BaseLayout — single page shell for every Slow Hours route.
 *
 * ARCHETYPE: ultra-minimal centered column. No header bar, no sidebar, no
 * mobile tab bar. Every route is a single narrow reading column: a small
 * centered wordmark (Masthead) at the top, the page content, then the quiet
 * inline nav row + pull-quote (Footer). Nothing is sticky; the page reads
 * top to bottom like a notebook page. This is what makes the site structurally
 * its own — deliberately NOT the top-nav card-grid sibling shell.
 */
import '~/styles/global.css'
import '~/styles/oriz-ui-overrides.css'
import 'katex/dist/katex.min.css'
import '~/styles/tokens.css'
import { ClientRouter } from 'astro:transitions'
import ConsentBanner from '~/components/chrome/ConsentBanner.astro'
import FamilyChrome from '~/components/chrome/FamilyChrome.astro'
import FeedDiscovery from '~/components/FeedDiscovery.astro'
import Footer from '~/components/Footer.astro'
import Masthead from '~/components/Masthead.astro'

interface Props {
  title?: string
  description?: string
  canonical?: string
  noindex?: boolean
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
  image?: string
  type?: 'website' | 'article'
  pubDate?: Date
  updatedDate?: Date
  /** Let a route own its full width (no centered column) — e.g. the hero home. */
  wide?: boolean
}

const {
  title = 'Slow Hours',
  description = 'Notes on minimalism, daily routines, simple living and keeping focus — a calm lifestyle journal by Chirag Singhal.',
  canonical = `https://lifestyle-blog.oriz.in${Astro.url.pathname}`,
  noindex = false,
  jsonLd,
  image,
  type = 'website',
  pubDate,
  updatedDate,
  wide = false,
} = Astro.props

const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT
const beaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN
const ga4Id = import.meta.env.PUBLIC_GA4_ID
const ogImage = image ? new URL(image, 'https://lifestyle-blog.oriz.in').toString() : undefined
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Slow Hours" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {type === 'article' && pubDate && (
      <meta property="article:published_time" content={pubDate.toISOString()} />
    )}
    {type === 'article' && updatedDate && (
      <meta property="article:modified_time" content={updatedDate.toISOString()} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@chirag127" />

    <!-- Apply the saved reading theme before paint so the editorial surface never flashes. -->
    <script is:inline>
      {`(() => {
        try {
          const theme = localStorage.getItem('oriz:theme')
          if (theme && theme !== 'auto' && ['light', 'dark', 'sepia', 'hc'].includes(theme)) {
            document.documentElement.dataset.theme = theme
          }
        } catch (_) {}
      })()`}
    </script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#f7f6f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1815" media="(prefers-color-scheme: dark)" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <FeedDiscovery />

    <ClientRouter />

    {jsonLd && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(Array.isArray(jsonLd) ? jsonLd : [jsonLd])}
      />
    )}

    {adsenseClient && (
      <script
        is:inline
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
        crossorigin="anonymous"
      />
    )}

    {beaconToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${beaconToken}"}`}
      />
    )}

    {ga4Id && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`} />
        <script is:inline define:vars={{ ga4Id }}>
          {`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config',ga4Id);`}
        </script>
      </>
    )}
  </head>
  <body>
    <FamilyChrome slug="oriz-pages-blog-app" title="Blog" accent="var(--accent)" />
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="column">
      <Masthead />
      <main id="main" class:list={["reading", wide && "is-wide"]}><slot /></main>
    </div>
    <Footer />
    <ConsentBanner />

    <script>
      if ('serviceWorker' in navigator && location.hostname !== 'localhost') {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {})
        })
      }
    </script>
  </body>
</html>

<style>
  /* One spine for the whole page: masthead, content, footer all share it. */
  .column {
    width: 100%;
  }
  .reading {
    max-width: 640px;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 5vw, 2rem);
  }
  /* The home hero opts into a slightly wider column for its ribbon. */
  .reading.is-wide {
    max-width: 720px;
  }
</style>
