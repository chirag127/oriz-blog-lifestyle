---
/*
 * Footer — the quiet close of the reading column.
 *
 * In this ultra-minimal centered archetype the footer carries the ONLY
 * navigation on the page: a single hairline-separated inline row (Latest ·
 * Themes · Archive · About · Search · RSS), centered under a short serif
 * pull-quote. No column grid, no link farm — the whole footer is one narrow
 * centered stack that matches the reading column above it.
 */
import LegalFooter from '~/components/chrome/legal/LegalFooter.astro'

const nav = [
  { label: 'Latest', href: '/' },
  { label: 'Themes', href: '/categories/' },
  { label: 'Archive', href: '/archive/' },
  { label: 'Now', href: '/now/' },
  { label: 'About', href: '/about/' },
]
const current = Astro.url.pathname
const isActive = (href: string) =>
  href === '/' ? current === '/' : current.startsWith(href)
---
<footer class="blog-footer" role="contentinfo">
  <div class="bf-inner">
    <blockquote class="bf-quote">
      <span aria-hidden="true" class="bf-q-mark">“</span>
      How you spend your hours is how you spend your life.
      <cite class="bf-quote-attr">Slow Hours</cite>
    </blockquote>

    <nav class="bf-nav" aria-label="Primary">
      {nav.map((item, i) => (
        <>
          {i > 0 && <span class="bf-sep" aria-hidden="true">·</span>}
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
        </>
      ))}
      <span class="bf-sep" aria-hidden="true">·</span>
      <a href="/search/">Search</a>
      <span class="bf-sep" aria-hidden="true">·</span>
      <a href="/rss.xml">RSS</a>
    </nav>

    <LegalFooter
      github="https://github.com/chirag127/oriz-blog-lifestyle"
      appName="Slow Hours"
      bio="A calm lifestyle notebook on minimalism, daily routines and simple living, by Chirag Singhal."
      rss="/rss.xml"
    />
  </div>
</footer>
<style>
  .blog-footer {
    margin-top: clamp(4rem, 12vw, 7rem);
    border-top: 1px solid var(--color-rule, var(--rule));
    background: transparent;
    color: var(--color-ink, var(--ink));
  }
  .bf-inner {
    max-width: 640px;
    margin-inline: auto;
    padding: clamp(3rem, 8vw, 4.5rem) clamp(1.25rem, 5vw, 2rem) clamp(2.5rem, 6vw, 3.5rem);
    text-align: center;
  }
  .bf-quote {
    margin: 0 0 clamp(1.75rem, 5vw, 2.5rem);
    font-family: var(--font-display, 'Fraunces', Georgia, serif);
    font-optical-sizing: auto;
    font-style: normal;
    font-weight: 460;
    font-size: clamp(19px, 3vw, 26px);
    line-height: 1.4;
    letter-spacing: -0.015em;
    color: var(--color-ink, var(--ink));
  }
  .bf-q-mark {
    font-size: 1.4em;
    line-height: 0;
    color: var(--color-accent, var(--accent));
    margin-right: 2px;
  }
  .bf-quote-attr {
    display: block;
    margin-top: 0.9rem;
    font-family: var(--font-mono, ui-monospace);
    font-style: normal;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-ink-mute, var(--ink-mute));
  }
  .bf-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.35rem 0.5rem;
    font-family: var(--font-mono, ui-monospace);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: clamp(2rem, 5vw, 2.75rem);
  }
  .bf-nav a {
    color: var(--color-ink-mute, var(--ink-mute));
    text-decoration: none;
    padding-block: 0.2rem;
    border-bottom: 1px solid transparent;
    transition: color var(--dur-fast, 120ms) ease, border-color var(--dur-fast, 120ms) ease;
  }
  .bf-nav a:hover,
  .bf-nav a:focus-visible {
    color: var(--color-accent, var(--accent));
    border-bottom-color: var(--color-accent, var(--accent));
  }
  .bf-nav a[aria-current='page'] {
    color: var(--color-ink, var(--ink));
    border-bottom-color: var(--rule-strong, var(--rule));
  }
  .bf-sep {
    color: var(--rule-strong, var(--rule));
  }
  @media (prefers-reduced-motion: reduce) {
    .bf-nav a { transition: none; }
  }
</style>
